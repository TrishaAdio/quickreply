# QuickReply needs exactly three values. Copy to .env (python setup.py does it for you).
# MongoDB connection string. The database name in the URI path is used; without one
# QuickReply uses the database 'quickreply'. Collections/indexes are created automatically.
MONGO_URL=mongodb+srv://YOUR_CONNECTION_STRING
# Telegram application credentials from https://my.telegram.org -> API development tools.
API_ID=YOUR_TELEGRAM_API_ID
API_HASH=YOUR_TELEGRAM_API_HASH
